<Window x:Class="Transkription.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen – Transkription"
        Width="800" Height="600" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Height="28" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Abbrechen" Width="90" Height="28" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <!-- Fußschalter -->
            <TabItem Header="Fußschalter">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
                        Jedem Pedal kann eine eigene Funktion zugeordnet werden. Zum Einrichten bei einem Pedal auf
                        <Bold>Anlernen</Bold> klicken und das gewünschte Pedal treten und wieder loslassen (falls nötig ein zweites Mal).
                        Die Pedale wirken auch, während in Word oder einem anderen Programm geschrieben wird.
                    </TextBlock>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Voreinstellung:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Padding="10,3" Margin="0,0,6,0" Click="PresetHold_Click"
                                Content="Halten (Zurückspulen · Abspielen · Vorspulen · kurz zurück)"
                                ToolTip="Wie bei Diktier-Fußschaltern üblich: Die Funktion wirkt, solange das Pedal getreten wird." />
                        <Button Padding="10,3" Click="PresetToggle_Click"
                                Content="Umschalten (kurz zurück · Abspielen/Anhalten · kurz vor · Anhalten)"
                                ToolTip="Ein Tritt startet bzw. hält an; die äußeren Pedale springen kurz zurück bzw. vor." />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button HorizontalAlignment="Left" Padding="10,3" Content="Weiteres Pedal hinzufügen" Click="AddPedal_Click" />
                        <TextBlock x:Name="LastSignalText" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" Text="Letztes Signal: –" />
                    </StackPanel>

                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Background="#F3F5F8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="290" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pedal" FontWeight="SemiBold" Margin="8,6" />
                                    <TextBlock Grid.Column="1" Text="Funktion" FontWeight="SemiBold" Margin="8,6" />
                                    <TextBlock Grid.Column="2" Text="Signal" FontWeight="SemiBold" Margin="8,6" />
                                </Grid>
                                <ItemsControl x:Name="PedalRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="290" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                                                    <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Action"
                                                              SelectedValue="{Binding Action, Mode=TwoWay}" />
                                                    <DockPanel Grid.Column="2" Margin="8,0">
                                                        <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="4,0,8,0" ToolTip="Pedal entfernen" Click="RemovePedal_Click" />
                                                        <Button DockPanel.Dock="Right" Content="{Binding LearnButtonText}" Width="90" Margin="4,0,0,0" Click="LearnPedal_Click" />
                                                        <TextBlock Text="{Binding SignalText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SignalText}" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Tasten -->
            <TabItem Header="Tasten">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Tastenkürzel wirken systemweit – auch wenn gerade in Word oder einem anderen Programm geschrieben wird. Belegte Tasten kommen dort nicht an. Fußschalter, die sich als Tastatur ausgeben, werden hier eingerichtet." />
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3"
                            Content="Standardtasten wiederherstellen" Click="ResetKeys_Click" />

                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Background="#F3F5F8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Funktion" FontWeight="SemiBold" Margin="8,6" />
                                    <TextBlock Grid.Column="1" Text="Taste" FontWeight="SemiBold" Margin="8,6" />
                                </Grid>
                                <ItemsControl x:Name="KeyRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="300" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" />
                                                    <DockPanel Grid.Column="1" Margin="8,0">
                                                        <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="4,0,8,0" ToolTip="Taste entfernen" Click="ClearKey_Click" />
                                                        <Button DockPanel.Dock="Right" Content="{Binding KeyButtonText}" Width="96" Margin="4,0,0,0" Click="CaptureKey_Click" />
                                                        <TextBlock Text="{Binding KeyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Wiedergabe -->
            <TabItem Header="Wiedergabe">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#4A5563"
                               Text="Welche Funktion ein Pedal oder eine Taste hat (z. B. „Abspielen, solange gedrückt“ oder „Abspielen / Anhalten“), wird in den Reitern „Fußschalter“ und „Tasten“ festgelegt." />

                    <TextBlock Grid.Row="1" Text="Automatischer Rücksprung beim Anhalten (Sek.):" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="BackstepBox" Width="80" HorizontalAlignment="Left" Margin="0,6" />

                    <TextBlock Grid.Row="2" Text="Sprungweite für „Kurz zurück-/vorspringen“ (Sek.):" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SkipBox" Width="80" HorizontalAlignment="Left" Margin="0,6" />

                    <TextBlock Grid.Row="3" Text="Geschwindigkeit für „Schnell spulen“ (×):" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="WindBox" Width="80" HorizontalAlignment="Left" Margin="0,6" />

                    <TextBlock Grid.Row="4" Text="Schrittweite für Langsamer / Schneller (%):" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SpeedStepBox" Width="80" HorizontalAlignment="Left" Margin="0,6" />

                    <CheckBox Grid.Row="5" Grid.ColumnSpan="2" x:Name="RememberBox" Margin="0,10"
                              Content="Position jeder Datei merken und beim nächsten Öffnen dort fortsetzen" />
                </Grid>
            </TabItem>

            <!-- Allgemein -->
            <TabItem Header="Allgemein">
                <StackPanel Margin="14">
                    <CheckBox x:Name="HotkeysBox" Margin="0,6" Content="Tasten und Fußschalter aktiv" />
                    <CheckBox x:Name="TrayBox" Margin="0,6"
                              Content="Beim Schließen oder Minimieren im Infobereich (neben der Uhr) weiterlaufen" />
                    <CheckBox x:Name="TopmostBox" Margin="0,6" Content="Fenster immer im Vordergrund" />
                    <CheckBox x:Name="AutostartBox" Margin="0,6" Content="Mit Windows starten (im Infobereich)" />
                </StackPanel>
            </TabItem>

            <!-- Geräte -->
            <TabItem Header="Geräte">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontWeight="SemiBold" Text="Serieller Fußschalter (9-poliger Stecker, auch über USB-Seriell-Adapter)" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <TextBlock Text="Anschluss:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SerialBox" Width="140" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#4A5563" Margin="0,0,0,14"
                                   Text="Nur nötig für ältere Pedale mit seriellem Stecker. Nach der Auswahl im Reiter „Fußschalter“ die Pedale anlernen. USB-Fußschalter brauchen hier keine Einstellung." />

                        <TextBlock FontWeight="SemiBold" Text="USB-Eingabegeräte" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,6"
                                   Text="Ein angeschlossener USB-Fußschalter sollte hier erscheinen (Philips-Geräte haben meist die VID 0911). Im Reiter „Fußschalter“ zeigt „Letztes Signal“ beim Treten, von welchem Gerät es kommt." />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3"
                            Content="Neu suchen" Click="Rescan_Click" />
                    <ListBox x:Name="DeviceList" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
