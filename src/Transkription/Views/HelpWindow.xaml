<Window x:Class="Transkription.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bedienung – Transkription"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Schließen" Width="90" Height="28"
                Margin="0,10,0,0" IsCancel="True" IsDefault="True" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="HelpText" TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
    </DockPanel>
</Window>
